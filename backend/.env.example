# Copy to backend/.env and fill secrets. Never commit real values.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
API_PORT=8001
API_HOST=0.0.0.0
API_DEBUG=true

# Public API (Railway production URL or ngrok for local Twilio webhooks)
PUBLIC_API_BASE_URL=https://sales-agent-new-updated-production.up.railway.app

# --- Twilio Voice (from Twilio Console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_WEBHOOK_BASE_URL=https://sales-agent-new-updated-production.up.railway.app
TWILIO_VALIDATE_WEBHOOKS=false

# --- Company cPanel IMAP/SMTP ---
MAILBOX_ENABLED=true
MAILBOX_IMAP_HOST=67.23.252.42
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=67.23.252.42
MAILBOX_SMTP_PORT=465
MAILBOX_SSL_HOSTNAME=mail.kafi-group.com
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_CREDENTIALS_KEY=
MAILBOX_TENANT_ID=consumers

# Per-user mailbox emails (passwords: set here OR on Users page — required for inbox/send)
MAILBOX_ADMIN_EMAIL=khalid.paracha@kafi-group.com
MAILBOX_ADMIN_PASSWORD=
MAILBOX_ADMIN_DISPLAY_NAME=Khalid Paracha
MAILBOX_ASIM_EMAIL=marketing@kafi-group.com
MAILBOX_ASIM_PASSWORD=
MAILBOX_ASIM_DISPLAY_NAME=Anjum Ali
MAILBOX_USMAN_EMAIL=info@kafi-group.com
MAILBOX_USMAN_PASSWORD=
MAILBOX_USMAN_DISPLAY_NAME=Asad Ali
MAILBOX_SADIA_EMAIL=essence@kafi-group.com
