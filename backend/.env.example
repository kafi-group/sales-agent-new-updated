# Copy to backend/.env and fill secrets. Never commit real values.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
API_PORT=8001
API_HOST=0.0.0.0
API_DEBUG=true

# Public API (Railway production URL or ngrok for local Twilio webhooks)
PUBLIC_API_BASE_URL=https://sales-agent-new-updated-production.up.railway.app

# --- Twilio Voice (from Twilio Console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_WEBHOOK_BASE_URL=https://sales-agent-new-updated-production.up.railway.app
TWILIO_VALIDATE_WEBHOOKS=false

# --- Company cPanel IMAP/SMTP ---
MAILBOX_ENABLED=true
MAILBOX_IMAP_HOST=67.23.252.42
MAILBOX_IMAP_PORT=993
MAILBOX_SMTP_HOST=67.23.252.42
MAILBOX_SMTP_PORT=465
MAILBOX_SSL_HOSTNAME=mail.kafi-group.com
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILBOX_CREDENTIALS_KEY=
MAILBOX_TENANT_ID=consumers

# Per-user mailbox emails (passwords: set here OR on Users page — required for inbox/send)
MAILBOX_ADMIN_EMAIL=khalid.paracha@kafi-group.com
MAILBOX_ADMIN_PASSWORD=
MAILBOX_ADMIN_DISPLAY_NAME=Khalid Paracha
MAILBOX_ASIM_EMAIL=marketing@kafi-group.com
MAILBOX_ASIM_PASSWORD=
MAILBOX_ASIM_DISPLAY_NAME=Anjum Ali
MAILBOX_USMAN_EMAIL=info@kafi-group.com
MAILBOX_USMAN_PASSWORD=
MAILBOX_USMAN_DISPLAY_NAME=Asad Ali
MAILBOX_SADIA_EMAIL=essence@kafi-group.com
MAILBOX_SADIA_PASSWORD=
MAILBOX_SADIA_DISPLAY_NAME=Sadia Paracha

# Optional legacy Hotmail/Outlook Graph (single global token) — usually not needed with cPanel
# MAILBOX_CLIENT_ID=
# MAILBOX_CLIENT_SECRET=
# MAILBOX_REFRESH_TOKEN=
# MAILBOX_EMAIL=

# --- Vercel mailer (must match mailer-pied project) ---
MAILER_PUBLIC_URL=https://mailer-pied.vercel.app
MAILER_HANDOFF_SECRET=

# --- Gemini (never commit real keys) ---
# Each slot: KEY = dedicated key 1, KEYS = key 2 + optional shared extras.
# Retry order: key1 (base + 2 fallbacks) → key2 → extras → wrap back to key1 once.
# Base: gemini-3.1-flash-lite  Fallbacks: gemini-2.5-flash,gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash

CHATBOT_GEMINI_API_KEY=
CHATBOT_GEMINI_API_KEYS=
CHATBOT_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-3.5-flash

SALES_ASSISTANT_GEMINI_API_KEY=
SALES_ASSISTANT_GEMINI_API_KEYS=
SALES_ASSISTANT_GEMINI_MODEL=gemini-3.1-flash-lite
SALES_ASSISTANT_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash

KPI_GEMINI_API_KEY=
KPI_GEMINI_API_KEYS=
KPI_GEMINI_MODEL=gemini-3.1-flash-lite
KPI_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash

AI_MODE_QUERY_GEMINI_API_KEY=
AI_MODE_QUERY_GEMINI_API_KEYS=
AI_MODE_QUERY_GEMINI_MODEL=gemini-3.1-flash-lite
AI_MODE_QUERY_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash

AI_MODE_AUTO_REPLY_GEMINI_API_KEY=
AI_MODE_AUTO_REPLY_GEMINI_API_KEYS=
AI_MODE_AUTO_REPLY_GEMINI_MODEL=gemini-3.1-flash-lite
AI_MODE_AUTO_REPLY_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash

EMAIL_TEMPLATE_GEMINI_API_KEY=
EMAIL_TEMPLATE_GEMINI_API_KEYS=
EMAIL_TEMPLATE_GEMINI_MODEL=gemini-3.1-flash-lite
EMAIL_TEMPLATE_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash
